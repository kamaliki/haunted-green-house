# ============================================
# Haunted Greenhouse Frontend - Environment Configuration Template
# ============================================
# Copy this file to .env.local and update the values
# Command: cp .env.example .env.local
# ============================================

# Backend API Configuration
# --------------------------
# Base URL for the NestJS backend REST API
# Default for local development: http://localhost:3000
# Production: Update to your production backend URL (e.g., https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket URL for real-time sensor data updates
# Default for local development: ws://localhost:3000
# Production: Use wss:// (secure WebSocket) instead of ws:// (e.g., wss://api.yourdomain.com)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# NextAuth Configuration
# -----------------------
# Canonical URL of this Next.js application
# Must match the URL users access in their browser
# Default for local development: http://localhost:3001
# Production: Update to your production URL (e.g., https://yourdomain.com)
NEXTAUTH_URL=http://localhost:3001

# Secret key for encrypting JWT tokens and session data
# IMPORTANT: Generate a secure random string for production!
# Generate with: openssl rand -base64 32
# Minimum 32 characters recommended
# NEVER commit the actual secret to version control!
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# ============================================
# Additional Configuration (Optional)
# ============================================
# Uncomment and configure these if needed:

# Internal API URL (Docker only)
# Used for server-side API calls within Docker network
# Only needed when running in Docker Compose
# INTERNAL_API_URL=http://backend:3000

# Node Environment
# NODE_ENV=development

# Enable debug logging
# NEXT_PUBLIC_DEBUG=true

# API Request Timeout (milliseconds)
# NEXT_PUBLIC_API_TIMEOUT=30000

# WebSocket Reconnection Settings
# NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=5
# NEXT_PUBLIC_WS_RECONNECT_DELAY=3000
