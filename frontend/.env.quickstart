# ============================================
# QUICK START - Copy this to .env.local
# ============================================
# For local development, these defaults should work out of the box
# Just run: cp .env.quickstart .env.local
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev-secret-key-not-for-production

# ============================================
# That's it! Start the dev server with: npm run dev
# For production, see .env.example and ENVIRONMENT_CONFIGURATION.md
# ============================================
