# MQTT Broker (Docker internal hostname)
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=greenhouse
MQTT_PASSWORD=your-secure-password
MQTT_CLIENT_ID_PREFIX=haunted-greenhouse

# InfluxDB (Docker internal hostname)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=haunted-greenhouse
INFLUXDB_BUCKET=sensor-data

# Backend
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Docker internal hostname)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=haunted_greenhouse

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=10

# Alerts
ALERT_EMAIL_FROM=alerts@hauntedgreenhouse.com
ALERT_EMAIL_TO=operator@hauntedgreenhouse.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Irrigation Settings
IRRIGATION_MAX_DURATION_SECONDS=1800
IRRIGATION_MIN_INTERVAL_SECONDS=7200
IRRIGATION_DEFAULT_FLOW_RATE=80
RESERVOIR_LOW_THRESHOLD=20
RESERVOIR_CRITICAL_THRESHOLD=10

# Sensor Settings
SENSOR_HEALTH_CHECK_INTERVAL=300000
ALERT_COOLDOWN_MINUTES=5

# Weather API (OpenWeatherMap)
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/forecast
WEATHER_API_KEY=your-openweathermap-api-key
LOCATION_LAT=37.7749
LOCATION_LON=-122.4194

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-key